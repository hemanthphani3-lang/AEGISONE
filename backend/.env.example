# =====================================================================
# AccessGuard Environment Configuration Template
# =====================================================================
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT REPOSITORY.
# THIS FILE CONTAINS SAFE PLACEHOLDER VALUES FOR DEVELOPMENT.
# =====================================================================

# ---------------------------------------------------------------------
# PUBLIC CONFIGURATION
# ---------------------------------------------------------------------
APP_ENV=development

# Keycloak OIDC Public Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=accessguard
KEYCLOAK_CLIENT_ID=accessguard-backend

# ---------------------------------------------------------------------
# SECRET CONFIGURATION (KEEP SECURE - EXCLUDED FROM GIT)
# ---------------------------------------------------------------------
# Database connection string containing credentials (local or Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://accessguard:accessguard_pass@localhost:5432/accessguard_db

# Keycloak Client Secret (Development placeholder)
KEYCLOAK_CLIENT_SECRET=accessguard-secret-dev

# Supabase Server-Side Configuration (Optional / Server-Only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key-placeholder>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key-placeholder>

# Resend Email API Configuration (Server-Only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy SMTP Configuration (Deprecated for AccessGuard MFA; kept for Keycloak compatibility if needed)
SUPABASE_SMTP_HOST=smtp.supabase.io
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_FROM=noreply@accessguard.local
SUPABASE_SMTP_USER=<your-supabase-smtp-user>
SUPABASE_SMTP_PASSWORD=<your-supabase-smtp-password>


